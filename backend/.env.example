APP_NAME="Santa Cruz Suite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SSO (Single Sign-On con las apps del grupo)
# Secreto compartido usado para canjear tickets SSO server-to-server.
# Debe ser IDÉNTICO en SCTOOLS y en cada app receptora (sigcom, sigcompro).
SSO_SHARED_SECRET=

# URLs base de las apps receptoras (usadas por el seeder del catálogo).
# El SSO redirige a "{URL}/sso/callback?ticket=...".
SIGCOM_URL=http://localhost:5173
SIGCOMPRO_URL=http://localhost:3000
EJECUTABLES_URL=http://localhost:5000

# Aprovisionamiento de usuarios (la suite escribe usuarios/permisos en las apps
# llamando su API /api/provisioning con el mismo SSO_SHARED_SECRET).
# Base del BACKEND de cada app. Si se omite, se usa la URL del catálogo de arriba.
# En desarrollo el backend suele estar en un puerto distinto al frontend:
SIGCOM_API_URL=http://localhost:3000
SIGCOMPRO_API_URL=http://localhost:3001
# Timeout (segundos) de las llamadas de aprovisionamiento.
PROVISIONING_TIMEOUT=8
